---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
}

const {
  title,
  description = "Azzeddine Lachgar, DevOps engineer. I build Kubernetes platforms that know what they cost.",
  type = "website",
} = Astro.props;

const fullTitle = title ? `${title} · Azzeddine Lachgar` : "Azzeddine Lachgar";
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const nav = [
  { href: "/writing/", label: "Writing" },
  { href: "/journey/", label: "Journey" },
  { href: "/work/", label: "Work" },
  { href: "/resume/", label: "Resume" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Azzeddine Lachgar, writing" href="/rss.xml" />
    <link rel="preload" href="/fonts/Archivo-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/PublicSans-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#f3f1ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0f13" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <div class="glow" aria-hidden="true"></div>

    <header class="site">
      <div class="wrap">
        <a class="mark" href="/" aria-label="azzhomelab.tech, home"><i aria-hidden="true"></i>azzhomelab.tech</a>
        <nav class="main" aria-label="Main">
          {nav.map((item) => (
            <a href={item.href} aria-current={path.startsWith(item.href) ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main id="content">
      <slot />
    </main>

    <footer class="site">
      <div class="wrap">
        <p>Azzeddine Lachgar · Casablanca · <a href="https://github.com/lachgar-Azzeddine">GitHub</a> · <a href="https://www.linkedin.com/in/lachgar-azzeddine">LinkedIn</a> · <a href="/rss.xml">RSS</a></p>
        <p class="meter" data-energy-footer hidden>
          Energy left today: <span class="live" data-energy="left">…</span> of <span data-energy="budget">…</span>
        </p>
      </div>
    </footer>

    <script>
      import { startEnergy } from "../lib/energy";
      startEnergy();
    </script>
  </body>
</html>
