---
import Base from "../layouts/Base.astro";
---
<Base title="Not found">
  <div class="wrap lost">
    <p class="kicker">404</p>
    <h1 class="display">Nothing here.</h1>
    <p class="lede">This page doesn't exist, so serving it costs no energy at all. That makes it the most efficient page on the site.</p>
    <p><a class="btn solid" href="/">Back to the lit part</a></p>
  </div>
</Base>

<style>
  .lost { padding-block: 96px 120px; }
  .lost p:last-child { margin-top: 32px; }
</style>
